{
  "schema_version": 1,
  "id": "claude",
  "name": "Claude Code",
  "config_paths": [
    "${CLAUDE_CONFIG_DIR}/settings.json",
    "${home}/.claude/settings.json"
  ],
  "format": "json",
  "selection": {
    "path": [
      "model"
    ]
  },
  "fields": [
    {
      "path": [
        "model"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_BASE_URL"
      ],
      "value": "${gateway}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_AUTH_TOKEN"
      ],
      "value": "magpie-local"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_DEFAULT_OPUS_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_DEFAULT_SONNET_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_DEFAULT_FABLE_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_SMALL_FAST_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_SUBAGENT_MODEL"
      ],
      "value": "${model}"
    },
    {
      "path": [
        "env",
        "ANTHROPIC_API_KEY"
      ],
      "value": "magpie-local"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_BEDROCK"
      ],
      "value": "0"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_VERTEX"
      ],
      "value": "0"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_FOUNDRY"
      ],
      "value": "0"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_ANTHROPIC_AWS"
      ],
      "value": "0"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD"
      ],
      "value": "0"
    },
    {
      "path": [
        "env",
        "CLAUDE_CODE_USE_MANTLE"
      ],
      "value": "0"
    }
  ]
}
